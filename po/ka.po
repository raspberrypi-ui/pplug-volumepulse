#: src/bluetooth.c:188 src/bluetooth.c:348
#, c-format
msgid "Bluetooth %s device not found"
msgstr "ბლუთუზის %s მოწყობილობა აღმოჩენილი არაა"

#. update dialog to show a warning
#: src/bluetooth.c:239
msgid "Audio device not found"
msgstr "აუდიომოწყობილობა აღმოჩენილი არაა"

#: src/bluetooth.c:255
#, c-format
msgid "Could not set profile for device : %s"
msgstr "პროფილის დაყენება შეუძლებელია მოწყობილობისთვის : %s"

#: src/bluetooth.c:299
#, c-format
msgid "Could not change %s to device : %s"
msgstr "%s-ის შეცვლა შეუძლებელია მოწყობილობაზე : %s"

#: src/bluetooth.c:415
#, c-format
msgid "Failed to connect to Bluetooth device - %s"
msgstr "ბლუთუზის მოწყობილობასთან დაკავშირება შეუძლებელია - %s"

#: src/bluetooth.c:509
msgid "Could not set device as output"
msgstr "მოწყობილობის გამოსატან მოწყობილობად დაყენება შეუძლებელია"

#: src/bluetooth.c:515
#, c-format
msgid "Connecting Bluetooth device '%s' as output..."
msgstr "ბლუთუზი მოწყობილობის '%s' გამოტანად დაყენება..."

#: src/bluetooth.c:556
msgid "Could not set device as input"
msgstr "მოწყობილობის შეყვანის მოწყობილობად დაყენება შეუძლებელია"

#: src/bluetooth.c:562
#, c-format
msgid "Connecting Bluetooth device '%s' as input..."
msgstr "ბლუთუზი მოწყობილობის '%s' შეყვანად დაყენება..."

#: src/commongui.c:146
msgid "AV Jack"
msgstr "AV ჯეკი"

#. update tooltip
#: src/commongui.c:209
msgid "Mic volume"
msgstr "მიკროფონის ხმის დონე"

#: src/commongui.c:209
msgid "Volume control"
msgstr "ხმის კონტროლი"

#. Create a check button as the child of the vertical box.
#: src/commongui.c:302
msgid "Mute"
msgstr "დადუმება"

#: src/commongui.c:491
msgid "No audio devices found"
msgstr "მოწყობილობები აღმოჩენილი არაა"

#: src/commongui.c:506
msgid "Device Profiles..."
msgstr "მოწყობილობის პროფილები..."

#: src/commongui.c:542
msgid "Input from this device not available in the current profile"
msgstr "ამ მოწყობილობიდან შეყვანა მიმდინარე პროფილში ხელმისაწვდომი არაა"

#: src/commongui.c:547
msgid "Output to this device not available in the current profile"
msgstr "ამ მოწყობილობიდან გამოტანა მიმდინარე პროფილში ხელმისაწვდომი არაა"

#: src/commongui.c:681
msgid "Device Profiles"
msgstr "მოწყობილობის პროფილები"

#: src/commongui.c:707 data/lxplug-volumepulse.ui:73
msgid "_OK"
msgstr "_დიახ"

#: src/commongui.c:739
msgid "Device not connected"
msgstr "მოწყობილობა მიერთებული არაა"

#: src/volumepulse.c:141
msgid "HDMI"
msgstr "HDMI"

#: src/volumepulse.c:489
msgid "Display and control volume for PulseAudio"
msgstr "PulseAudio-ის ხმის დონის ჩვენება და მართვა"

